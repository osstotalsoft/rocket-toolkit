{
  "name": "@totalsoft/metrics",
  "description": "A custom plugin for metrics and diagnostics",
  "version": "2.0.1",
  "author": "TotalSoft",
  "packageManager": "yarn@3.2.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osstotalsoft/rocket-toolkit.git",
    "directory": "packages/metrics"
  },
  "keywords": [
    "metrics",
    "diagnostics",
    "plugin"
  ],
  "scripts": {
    "build": "run clean && tsc --project tsconfig.build.json",
    "lint": "eslint src/*.ts",
    "clean": "rimraf dist",
    "test": "jest --collectCoverage --passWithNoTests --verbose --silent=false --runInBand"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "graphql": "^16.14.2",
    "koa": "^3.2.1",
    "numeral": "^2.0.6",
    "pino": "^10.3.1",
    "ramda": "^0.32.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.3",
    "@types/numeral": "^2.0.5",
    "@types/ramda": "^0.32.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "verbose": true
  }
}
