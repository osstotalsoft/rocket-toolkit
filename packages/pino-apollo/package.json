{
  "name": "@totalsoft/pino-apollo",
  "description": "A custom Apollo logging plugin",
  "version": "3.1.1",
  "author": "TotalSoft",
  "packageManager": "yarn@3.2.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "composite": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osstotalsoft/rocket-toolkit.git",
    "directory": "packages/pino-apollo"
  },
  "keywords": [
    "Apollo",
    "pino",
    "logger",
    "log",
    "plugin"
  ],
  "scripts": {
    "build": "run clean && tsc --project tsconfig.build.json",
    "lint": "eslint src/*.ts",
    "clean": "rimraf dist",
    "test": "jest --collectCoverage --passWithNoTests --verbose --silent=false --runInBand"
  },
  "devDependencies": {
    "@jest/types": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@types/ramda": "^0.32.0",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@colors/colors": "^1.6.0",
    "@totalsoft/correlation": "3.0.1",
    "graphql": "^16.14.2",
    "pino": "^10.3.1",
    "ramda": "^0.32.0",
    "uuid": "^11.1.1"
  },
  "jest": {
