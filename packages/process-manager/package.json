{
  "name": "@totalsoft/process-manager",
  "version": "1.1.2",
  "description": "Process Manager Library",
  "packageManager": "yarn@4.5.3",
  "scripts": {
    "build": "run clean && tsc",
    "lint": "eslint src/*.ts",
    "clean": "rimraf dist",
    "test": "tsx __tests__/process-algebra.test.ts",
    "test:all": "tsx __tests__/*.test.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./effects": {
      "import": "./dist/effects.js",
      "types": "./dist/effects.d.ts"
    },
    "./event-store": {
      "import": "./dist/event-store/index.js",
      "types": "./dist/event-store/index.d.ts"
    },
    "./mediator": {
      "import": "./dist/mediator.js",
      "types": "./dist/mediator.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osstotalsoft/rocket-toolkit.git",
    "directory": "packages/process-manager"
  },
  "type": "module",
  "dependencies": {
    "mssql": "^12.7.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.1.0",
    "rimraf": "^6.1.3",
    "supports-color": "^10.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
